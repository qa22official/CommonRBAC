# 复制为 .env 后仅用于本地开发；不要把真实密钥提交到仓库。
# 初始 admin 密码：至少 8 位，包含大小写字母与数字（首次启动使用）。
RBAC_ADMIN_PASSWORD=Admin@12345

# JWT HS256 密钥：至少 32 字节。不要使用本示例值；生产环境由配置中心/环境变量下发，并定期轮换。
RBAC_JWT_KEY_1=replace-with-at-least-32-bytes-of-random-data

# 可选：可信代理地址/CIDR，逗号分隔。为空表示不信任 X-Forwarded-For。
RBAC_TRUSTED_PROXIES=

# 可选：允许的前端 Origin，逗号分隔，精确匹配。
RBAC_CORS_ORIGINS=http://localhost:5173
